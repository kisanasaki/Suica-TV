[Unit]
Description=Suica TV Core
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/suica-tv
Environment=RUST_LOG=suica_core=info,tower_http=info
ExecStart=%h/.local/bin/suica-core --config %h/.config/suica-tv/suica-core.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
